#: contact/templates/contact/success.html:39
msgid "<strong>Responsable del tratamiento</strong><br />Joaquín Denis Tremols"
msgstr "<strong>Responsable du traitement</strong><br />Joaquín Denis Tremols"

#: contact/templates/contact/contact copy.html:107
msgid ""
"<strong>Dirección del responsable</strong><br />Calle 25 de Abril 10, piso "
