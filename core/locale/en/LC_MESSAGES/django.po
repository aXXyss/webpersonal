#: templates/core/about.html:5 templates/core/home.html:9
msgid ""
"Joaquin Denis — Programador web freelance en Torrent, Valencia. "
"Especializado en Django y Python. Desarrollo web a medida, e-commerce y "
"software de gestión para empresas."
msgstr ""
"Joaquin Denis — Freelance web developer in Torrent, Valencia. Specialized in "
"Django and Python. Custom web development, e-commerce and business "
"management software."

