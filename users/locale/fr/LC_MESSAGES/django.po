#: forms.py:34
msgid "Este nombre de usuario ya está en uso."
msgstr "Ce nom d'utilisateur est déjà utilisé."

#: forms.py:40
msgid "Ya existe una cuenta con este email."
msgstr "Un compte avec cet email existe déjà."

#: forms.py:48
msgid "Las contraseñas no coinciden."
msgstr "Les mots de passe ne correspondent pas."

#: forms.py:65
#, python-format
msgid ""
"Hola %(username)s,\n"
"\n"
"Gracias por registrarte en aXXyss Soluciones.\n"
"\n"
"Para activar tu cuenta haz clic en el siguiente enlace:\n"
"\n"
"%(url)s\n"
"\n"
"Si no te has registrado, ignora este mensaje.\n"
"\n"
"Un saludo,\n"
"Joaquin Denis\n"
"aXXyss Soluciones\n"
"https://axxyss.com\n"
msgstr ""
"Bonjour %(username)s,\\n\\nMerci de vous être inscrit sur aXXyss Soluciones."
"\\n\\nPour activer votre compte, cliquez sur le lien suivant :"
"\\n\\n%(url)s\\n\\nSi vous ne vous êtes pas inscrit, veuillez ignorer ce "
"message.\\n\\nCordialement,\\nJoaquin Denis\\naXXyss Soluciones\\nhttps://"
"axxyss.com\\n\n"

#: forms.py:69
msgid "Activa tu cuenta en aXXyss Soluciones"
msgstr "Activez votre compte sur aXXyss Soluciones"

#: templates/users/account_activated.html:4
msgid "Cuenta activada"
msgstr "Compte activé"

#: templates/users/account_activated.html:9
msgid "¡Cuenta activada!"
msgstr "Compte activé !"

#: templates/users/account_activated.html:16
msgid "¡Tu cuenta está lista!"
msgstr "Votre compte est prêt !"

#: templates/users/account_activated.html:17
msgid "Tu cuenta ha sido activada correctamente. Ya puedes iniciar sesión."
msgstr ""
"Votre compte a été activé avec succès. Vous pouvez maintenant vous connecter."

#: templates/users/account_activated.html:18 templates/users/login.html:4
#: templates/users/login.html:9 templates/users/login.html:43
#: templates/users/password_reset_complete.html:17
msgid "Iniciar sesión"
msgstr "Se connecter"

#: templates/users/login.html:29
msgid "Usuario"
msgstr "Utilisateur"

#: templates/users/login.html:34 templates/users/register.html:31
#: templates/users/register.html:32
msgid "Contraseña"
msgstr "Mot de passe"

#: templates/users/login.html:40
msgid "Recordar"
msgstr "Mémoriser"

#: templates/users/login.html:46
msgid "¿Olvidaste tu contraseña?"
msgstr "Mot de passe oublié ?"

#: templates/users/login.html:49
msgid "Todavía no tiene una cuenta?"
msgstr "Vous n'avez pas encore de compte ?"

#: templates/users/login.html:50 templates/users/register.html:40
msgid "Registrarse"
msgstr "S'enregistrer"

#: templates/users/password_reset.html:3 templates/users/password_reset.html:6
msgid "Restablecer contraseña"
msgstr "Réinitialiser le mot de passe"

#: templates/users/password_reset.html:17
msgid ""
"Introduce tu email y te enviaremos un enlace para restablecer tu contraseña."
msgstr ""
"Entrez votre email et nous vous enverrons un lien pour réinitialiser votre "
"mot de passe."

#: templates/users/password_reset.html:21 templates/users/register.html:23
#: templates/users/register.html:24
msgid "Correo electrónico"
msgstr "Courrier électronique"

#: templates/users/password_reset.html:24
msgid "Enviar enlace"
msgstr "Envoyer le lien"

#: templates/users/password_reset_complete.html:3
msgid "Contraseña cambiada"
msgstr "Mot de passe modifié"

#: templates/users/password_reset_complete.html:6
msgid "¡Contraseña cambiada!"
msgstr "Mot de passe modifié!"

#: templates/users/password_reset_complete.html:15
msgid "¡Listo!"
msgstr "C'est fait !"

#: templates/users/password_reset_complete.html:16
msgid "Tu contraseña ha sido cambiada correctamente."
msgstr "Votre mot de passe a été modifié avec succès."

#: templates/users/password_reset_confirm.html:3
#: templates/users/password_reset_confirm.html:6
#: templates/users/password_reset_confirm.html:21
msgid "Nueva contraseña"
msgstr "Nouveau mot de passe"

#: templates/users/password_reset_confirm.html:24
msgid "Confirmar contraseña"
msgstr "Confirmer le mot de passe"

#: templates/users/password_reset_confirm.html:32
msgid "Cambiar contraseña"
msgstr "Changer le mot de passe"

#: templates/users/password_reset_confirm.html:37
msgid "El enlace no es válido o ha expirado. Solicita uno nuevo."
msgstr "Le lien est invalide ou a expiré. Veuillez en demander un nouveau."

#: templates/users/password_reset_confirm.html:39
msgid "Solicitar nuevo enlace"
msgstr "Demander un nouveau lien"

#: templates/users/password_reset_done.html:3
#: templates/users/password_reset_done.html:6
msgid "Email enviado"
msgstr "Email envoyé"

#: templates/users/password_reset_done.html:15
msgid "Revisa tu correo"
msgstr "Vérifiez votre courrier"

#: templates/users/password_reset_done.html:16
msgid ""
"Si existe una cuenta con ese email, recibirás un enlace para restablecer tu "
"contraseña."
msgstr ""
"Si un compte existe avec cet email, vous recevrez un lien pour réinitialiser "
"votre mot de passe."

#: templates/users/password_reset_done.html:17
#: templates/users/registerok.html:23
msgid "Si no recibes el email en unos minutos, revisa la carpeta de spam."
msgstr ""
"Si vous ne recevez pas l'email dans quelques minutes, vérifiez votre dossier "
"spam."

#: templates/users/register.html:3
msgid "Registro"
msgstr "Enregistrement"

#: templates/users/register.html:6
msgid "Registrar una cuenta"
msgstr "Enregistrer un compte"

#: templates/users/register.html:27 templates/users/register.html:28
msgid "Nombre de usuario"
msgstr "Utilisateur"

#: templates/users/register.html:35 templates/users/register.html:36
msgid "Repetir contraseña"
msgstr "Répéter le mot de passe"

#: templates/users/registerok.html:4
msgid "Registro completado"
msgstr "Enregistrement terminé"

#: templates/users/registerok.html:9
msgid "Registro Completado"
msgstr "Enregistrement terminé"

#: templates/users/registerok.html:21
msgid "Revisa tu correo electrónico"
msgstr "Vérifiez votre courrier électronique"

#: templates/users/registerok.html:22
msgid ""
"Te hemos enviado un email de activación. Haz clic en el enlace para activar "
"tu cuenta."
msgstr ""
"Nous vous avons envoyé un email d'activation. Cliquez sur le lien pour "
"activer votre compte."

