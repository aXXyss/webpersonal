#: forms.py:34
msgid "Este nombre de usuario ya está en uso."
msgstr "This username is already taken."

#: forms.py:40
msgid "Ya existe una cuenta con este email."
msgstr "An account with this email already exists."

#: forms.py:48
msgid "Las contraseñas no coinciden."
msgstr "Passwords do not match."

#: forms.py:65
#, python-format
msgid ""
"Hola %(username)s,\n"
"\n"
"Gracias por registrarte en aXXyss Soluciones.\n"
"\n"
"Para activar tu cuenta haz clic en el siguiente enlace:\n"
"\n"
"%(url)s\n"
"\n"
"Si no te has registrado, ignora este mensaje.\n"
"\n"
"Un saludo,\n"
"Joaquin Denis\n"
"aXXyss Soluciones\n"
"https://axxyss.com\n"
msgstr ""
"Hello %(username)s,\\n\\nThank you for registering on aXXyss Soluciones."
"\\n\\nTo activate your account click the following link:"
"\\n\\n%(url)s\\n\\nIf you did not register, please ignore this message."
"\\n\\nBest regards,\\nJoaquin Denis\\naXXyss Soluciones\\nhttps://"
"axxyss.com\\n\n"

